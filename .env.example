# Скопируй в .env, не коммить .env в git.
# Telegram bot token. Leave empty to run in stub mode (polling disabled).
BOT_TOKEN=
# Tag the bot reacts to in chat messages.
BOT_TAG=@bot
LOG_LEVEL=info
NODE_ENV=development
# Used by the Telegraf webhook-listener in webhook mode (ignored in polling mode).
PORT=3000
# polling|webhook (default polling).
TELEGRAM_MODE=polling
# Required when TELEGRAM_MODE=webhook, public https URL, e.g. https://bot.example.com.
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram-webhook
